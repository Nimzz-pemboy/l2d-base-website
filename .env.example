# Salin file ini ke .env lalu isi dengan nilai asli kamu.
# JANGAN PERNAH commit file .env (berisi secret asli) ke Git — sudah di-ignore lewat .gitignore.

# --- Rate limiting (opsional tapi sangat direkomendasikan di production) ---
# Buat database Redis gratis di https://console.upstash.com lalu isi kredensial REST-nya.
# Jika kosong, API akan otomatis fallback ke rate limit in-memory (kurang akurat di
# lingkungan serverless karena bisa reset saat cold start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AI provider ---
# Default template ini pakai provider pihak ketiga tidak resmi
# (unlimitedai.chat, lihat src/lib/unlimitedai.js) — gratis, tanpa API key,
# tapi TIDAK cocok buat produksi/komersial serius. Kalau kamu ganti ke
# provider resmi (Anthropic, OpenAI, dll), tambahin API key kamu sendiri
# di sini, misal:
# ANTHROPIC_API_KEY=
